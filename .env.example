# Optional. When set, Gazette reads and writes the snapshot in Postgres
# (table gazette_snapshot from db/migrations/001_schema.sql) instead of data/store.json.
DATABASE_URL=
# Set to disable when talking to a local Postgres without SSL.
DATABASE_SSL=require

# Bearer token for POST /api/admin/ingest. Leave empty to keep the route closed.
INGEST_TOKEN=

# Bearer token Vercel Cron sends to GET /api/cron/ingest.
CRON_SECRET=

# Optional. When set, the web app calls this remote MCP URL.
# When empty, the server-side client speaks Streamable HTTP to the in-process handler.
MCP_SERVER_URL=
